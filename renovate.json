{
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Ignore Smarthome development snapshots",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nmarsman/smarthome-hub"],
      "matchCurrentValue": "/-SNAPSHOT$/",
      "enabled": false
    },
    {
      "description": "Automerge Docker updates after repository requirements are met",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
